# Combined reference template with placeholders only.
# Prefer backend/.env.example and frontend/.env.example for setup.
# Leave blank for the local Vite /api proxy. Set the deployed API origin otherwise.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional; defaults to the current site's /login?confirmed=1 URL.
VITE_SUPABASE_REDIRECT_URL=

# Backend settings (copy to backend/.env)
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# Per-process guard for billable live generation; add a shared gateway limit and provider spend cap in production.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
SUPABASE_URL=
SUPABASE_ANON_KEY=
