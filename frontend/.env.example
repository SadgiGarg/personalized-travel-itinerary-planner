# Local development: leave blank; Vite proxies /api to http://127.0.0.1:8000.
# Vercel + Render production: set this to the actual Render service URL
# (copy it from the Render dashboard; do not use the frontend URL).
VITE_API_BASE_URL=

# Optional Supabase Auth and saved-trip integration.
# The publishable key is intended for browser use; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional; defaults to the current site's /login?confirmed=1 URL.
VITE_SUPABASE_REDIRECT_URL=
